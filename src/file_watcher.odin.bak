// file_watcher.odin
package main

import "core:fmt"
import "core:os"


    import "core:sys/linux"

    import "core:sys/windows"


main :: proc() {
    watch_path :: "." // change to any directory you need

    when ODIN_OS == .Linux {
        // 1. create inotify instance (blocking by default)
        fd := linux.inotify_init()

        // 2. add a watch for the directory
        linux.inotify_add_watch(
            fd,
            watch_path,
            linux.IN_CREATE | linux.IN_DELETE | linux.IN_MODIFY |
            linux.IN_MOVED_FROM | linux.IN_MOVED_TO,
        )

        buf: [4096]u8

        for {
            // 3. block until events arrive
            n := os.read(fd, buf[:])
            offset := 0

            // 4. parse variable-length inotify_event records
            for offset < n {
                ev := (^linux.Inotify_Event)(&buf[offset])
                name: string
                if ev.len > 0 {
                    // name is a null-terminated string right after the fixed struct
                    name = string(
                        cstring(&buf[offset + size_of(linux.Inotify_Event)]),
                    )
                }
                fmt.println("event:", ev.mask, "name:", name)

                // advance by the struct size + the name length (already padded)
                offset += size_of(linux.Inotify_Event) + int(ev.len)
            }
        }
    } else when ODIN_OS == .Windows {
        // 1. open a handle to the directory
        path_w := windows.utf8_to_wstring(watch_path)
        hDir := windows.CreateFileW(
            path_w,
            windows.FILE_LIST_DIRECTORY,
            windows.FILE_SHARE_READ | windows.FILE_SHARE_WRITE | windows.FILE_SHARE_DELETE,
            nil,
            windows.OPEN_EXISTING,
            windows.FILE_FLAG_BACKUP_SEMANTICS,
            nil,
        )

        buf: [4096]u8

        for {
            bytesReturned: u32 = 0
            // 2. synchronous call – blocks until a change occurs
            windows.ReadDirectoryChangesW(
                hDir,
                &buf[0],
                u32(len(buf)),
                true, // watch subtree (set to false if you want top-level only)
                windows.FILE_NOTIFY_CHANGE_FILE_NAME |
                windows.FILE_NOTIFY_CHANGE_DIR_NAME |
                windows.FILE_NOTIFY_CHANGE_LAST_WRITE,
                &bytesReturned,
                nil,   // no overlapped -> synchronous
                nil,   // no completion routine
            )

            offset := 0
            for {
                // 3. walk the FILE_NOTIFY_INFORMATION list
                info := (^windows.FILE_NOTIFY_INFORMATION)(&buf[offset])
                name := windows.utf16_to_utf8(
                    info.FileName[: info.FileNameLength / 2],
                )
                fmt.println("action:", info.Action, "name:", name)

                if info.NextEntryOffset == 0 do break
                offset += int(info.NextEntryOffset)
            }
        }
    }
}